PORT=5000
NODE_ENV=production
MONGO_URI=mongodb://localhost:27017/kidland_school
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=https://erp.example.edu
MAX_FILE_SIZE=5242880

# Required for password-reset email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailer@example.com
SMTP_PASS=replace-with-smtp-password
MAIL_FROM="Kidland School <no-reply@example.edu>"
